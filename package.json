{
  "name": "@truenine/memory-sync",
  "version": "2026.10413.10237",
  "description": "Cross-AI-tool prompt synchronisation toolkit (CLI + Tauri desktop GUI) — one ruleset, multi-target adaptation. Monorepo powered by pnpm + Turbo.",
  "license": "AGPL-3.0-only",
  "keywords": [
    "ai",
    "prompt",
    "sync",
    "cli",
    "gui",
    "tauri",
    "desktop-app",
    "memory",
    "cursor",
    "kiro",
    "claude",
    "gemini",
    "codex",
    "warp",
    "jetbrains",
    "vscode",
    "plugin-pipeline",
    "monorepo",
    "cross-platform",
    "developer-tools",
    "ai-coding-assistant",
    "prompt-management",
    "ruleset-sync"
  ],
  "scripts": {
    "bootstrap": "tsx scripts/bootstrap/bootstrap.ts",
    "build": "turbo run build --ui=stream --log-order=grouped",
    "test": "turbo run test --ui=stream --log-order=grouped",
    "test:rust": "cargo test --workspace --exclude memory-sync-gui --lib --bins --tests",
    "test:gui": "pnpm -C gui test",
    "test:docs": "pnpm -C doc run validate:content && pnpm -C doc run build",
    "test:cli:integration": "cargo test -p tnmsc",
    "test:cli:contracts": "cargo test -p tnmsc --test command_contract",
    "test:cli:packaging-smoke": "cargo test -p tnmsc --test packaging_smoke -- --nocapture",
    "lint": "turbo run lint --ui=stream --log-order=grouped",
    "lint:fix": "turbo run lint:fix --ui=stream --log-order=grouped",
    "check:type": "turbo run check:type --ui=stream --log-order=grouped",
    "dev:doc": "pnpm -C doc dev",
    "build:doc": "pnpm -C doc build",
    "sync-versions": "tsx .githooks/sync-versions.ts"
  },
  "author": {
    "email": "truenine304520@gmail.com",
    "name": "TrueNine",
    "url": "https://trueine.org"
  },
  "engines": {
    "node": ">= 22"
  },
  "devEngines": {
    "node": ">= 25.6.1",
    "rust": ">= 1.88.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm tsx .githooks/sync-versions.ts"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "@truenine/eslint10-config": "catalog:",
    "@unocss/eslint-config": "catalog:",
    "@vue/eslint-config-prettier": "catalog:",
    "@vue/eslint-config-typescript": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "fast-check": "catalog:",
    "npm-run-all2": "catalog:",
    "prettier": "catalog:",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zx": "catalog:"
  }
}
