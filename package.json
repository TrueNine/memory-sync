{
  "name": "@truenine/memory-sync-cli",
  "type": "module",
  "version": "2025.12.27",
  "packageManager": "pnpm@10.26.2",
  "description": "TrueNine Life CLI Tools",
  "author": "TrueNine",
  "license": "UNLICENSED",
  "homepage": "https://github.com/TrueNine/memory-sync-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrueNine/memory-sync-cli.git",
    "directory": "_ai/scripts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "bin": {
    "tnmsc": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">= 25.2.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc --noEmit -p tsconfig.lib.json && eslint --fix && tsdown",
    "build:tsdown": "tsdown",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --fix",
    "type-check": "tsc --noEmit -p tsconfig.lib.json"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.3",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.3",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "winston": "^3.19.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@truenine/eslint9-config": "^1.0.20",
    "@types/fs-extra": "^11.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.0.3",
    "@types/picomatch": "^4.0.2",
    "@vitest/coverage-v8": "4.0.16",
    "eslint": "^9.39.2",
    "fast-check": "^4.5.2",
    "tsdown": "0.18.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  }
}
