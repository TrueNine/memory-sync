{
  "name": "@truenine/truenine-life-cli",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.24.0",
  "description": "TrueNine Life CLI Tools",
  "author": "TrueNine",
  "license": "private",
  "homepage": "https://github.com/TrueNine_Life",
  "repository": {
    "type": "git",
    "url": "git+https://https://github.com/TrueNine/TrueNine_Life",
    "directory": "_ai/scripts"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tnmsc": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">= 25.2.1"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc --noEmit -p tsconfig.lib.json && eslint --fix && tsdown",
    "build:tsdown": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --fix",
    "type-check": "tsc --noEmit -p tsconfig.lib.json"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.2",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@truenine/eslint9-config": "^1.0.19",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.0",
    "@types/picomatch": "^4.0.2",

    "@vitest/coverage-v8": "4.0.15",
    "eslint": "^9.39.1",
    "fast-check": "^4.4.0",
    "tsdown": "0.17.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  }
}
