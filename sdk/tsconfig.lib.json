{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "noEmit": false,
    "outDir": "../dist",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "env.d.ts",
    "tsdown.config.ts"
  ],
  "exclude": [
    "../node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
