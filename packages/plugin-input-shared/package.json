      "types": "./dist/scope/index.d.mts",
      "import": "./dist/scope/index.mjs"
    }
  },
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
