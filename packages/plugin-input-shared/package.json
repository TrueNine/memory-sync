{
  "private": true,
  "name": "@truenine/plugin-input-shared",
  "type": "module",
  "version": "2026.10223.10555",
  "description": "Shared abstract base classes and scope management for memory-sync input plugins",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
