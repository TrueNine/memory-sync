    "test": "vitest run",
    "prepublishOnly": "run-s build"
  },
  "dependencies": {},
  "devDependencies": {
    "@truenine/md-compiler": "workspace:*",
    "@truenine/plugin-shared": "workspace:*",
    "fast-glob": "catalog:"
