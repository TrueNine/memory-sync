{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": { "composite": true, "rootDir": "./src", "noEmit": false, "outDir": "../dist", "skipLibCheck": true },
  "include": ["src/**/*"],
  "exclude": ["../node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
