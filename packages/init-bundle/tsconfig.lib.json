{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "structure.config.ts",
    "env.d.ts"
  ],
  "exclude": [
    "../node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
