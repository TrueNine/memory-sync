{
  "name": "@truenine/memory-sync-mcp",
  "type": "module",
  "version": "2026.10412.11551",
  "description": "MCP stdio server for managing memory-sync prompt sources and translation artifacts",
  "author": "TrueNine",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/TrueNine/memory-sync",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrueNine/memory-sync.git",
    "directory": "mcp"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "memory-sync-mcp": "./dist/main.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "check": "run-p check:type lint",
    "lint": "eslint --cache --cache-location .eslintcache .",
    "lint:fix": "eslint --fix --cache --cache-location .eslintcache .",
    "prepublishOnly": "run-s build",
    "test": "vitest run",
    "check:type": "tsc --noEmit -p tsconfig.lib.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@truenine/memory-sync-sdk": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@truenine/eslint10-config": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "npm-run-all2": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
