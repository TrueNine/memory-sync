{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "../..",
    "noEmit": false,
    "outDir": "./dist",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "env.d.ts",
    "../../sdk/src/libraries/logger.ts",
    "../../sdk/src/core/native-binding-loader.ts"
  ],
  "exclude": [
    "../node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
