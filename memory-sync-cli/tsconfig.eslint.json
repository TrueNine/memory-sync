{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "memory-sync-cli/src/**/*.ts",
    "memory-sync-cli/src/**/*.test.ts",
    "memory-sync-cli/src/**/*.spec.ts",
    "env.d.ts",
    "memory-sync-cli/eslint.config.ts",
    "memory-sync-cli/tsdown.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "../node_modules", "dist", "coverage"]
}
