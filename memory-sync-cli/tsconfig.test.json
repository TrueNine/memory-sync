{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": ["vitest/globals", "node"] // Test environment specific
  },
  "include": [
    "memory-sync-cli/src/**/*.spec.ts",
    "memory-sync-cli/src/**/*.test.ts",
    "./vitest.config.ts", "vite.config.ts",
    "memory-sync-cli/env.d.ts"
  ],
  "exclude": [
    "../node_modules", "dist"]
}
