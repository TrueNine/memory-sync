{
  "name": "@truenine/memory-sync-cli",
  "type": "module",
  "version": "2026.10129.11105",
  "description": "TrueNine Memory Synchronization CLI Tools",
  "author": "TrueNine",
  "license": "UNLICENSED",
  "homepage": "https://github.com/TrueNine/memory-sync-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrueNine/memory-sync-cli.git",
    "directory": "_ai/scripts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./globals": {
      "types": "./dist/globals/index.d.mts",
      "import": "./dist/globals/index.mjs",
      "require": "./dist/globals/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "bin": {
    "tnmsc": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "run-s check build:bundle",
    "build:bundle": "pnpm exec tsdown",
    "check": "run-p typecheck lint",
    "lint": "eslint --cache .",
    "prepublishOnly": "run-s build",
    "test": "vitest run",
    "lintfix": "eslint --fix --cache .",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "fast-glob": "catalog:",
    "fs-extra": "catalog:",
    "mdast-util-mdx": "catalog:",
    "picocolors": "catalog:",
    "picomatch": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "remark-mdx": "catalog:",
    "remark-parse": "catalog:",
    "remark-stringify": "catalog:",
    "unified": "catalog:",
    "winston": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@truenine/desk-paths": "workspace:*",
    "@truenine/eslint9-config": "catalog:",
    "@types/estree": "catalog:",
    "@types/estree-jsx": "catalog:",
    "@types/fs-extra": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
