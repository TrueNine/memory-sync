{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memory Sync",
  "version": "0.1.0",
  "identifier": "org.truenine.memory-sync",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Memory Sync",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["tnmsc"]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://releases.truenine.org/memory-sync/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": ""
    }
  }
}
