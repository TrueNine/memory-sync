{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "env.d.ts",
    "eslint.config.ts",
    "tsdown.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "../node_modules",
    "dist",
    "coverage"
  ]
}
