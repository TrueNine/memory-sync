{
  "name": "@truenine/memory-sync-cli",
  "type": "module",
  "version": "2026.10413.10237",
  "description": "TrueNine Memory Synchronization CLI shell",
  "author": "TrueNine",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/TrueNine/memory-sync",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrueNine/memory-sync.git",
    "directory": "cli"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./schema.json": "./dist/tnmsc.schema.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "bin": {
    "tnmsc": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "dist/tnmsc.schema.json"
  ],
  "engines": {
    "node": ">= 22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "run-s build:shell build:native sync:sdk-assets",
    "build:native": "tsx scripts/build-native.ts",
    "build:shell": "tsdown",
    "check": "run-s check:run",
    "check:run": "run-p lint:run check:type:run",
    "lint": "run-s lint:run lint:rust",
    "lint:run": "eslint --cache --cache-location .eslintcache .",
    "lint:rust": "cargo fmt --check --manifest-path Cargo.toml",
    "prepublishOnly": "run-s build check",
    "test": "vitest run",
    "lint:fix": "run-s lint:fix:run lint:fix:rust",
    "lint:fix:run": "eslint --fix --cache --cache-location .eslintcache .",
    "lint:fix:rust": "cargo fmt --manifest-path Cargo.toml",
    "sync:sdk-assets": "tsx scripts/sync-sdk-dist.ts",
    "typecheck": "run-s check:type:run",
    "check:type:run": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "fast-glob": "catalog:",
    "jiti": "catalog:",
    "json5": "catalog:",
    "mdast-util-mdx": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "remark-mdx": "catalog:",
    "remark-parse": "catalog:",
    "remark-stringify": "catalog:",
    "unified": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "optionalDependencies": {
    "@truenine/memory-sync-cli-darwin": "workspace:*",
    "@truenine/memory-sync-cli-linux": "workspace:*",
    "@truenine/memory-sync-cli-win32": "workspace:*"
  },
  "devDependencies": {
    "@truenine/eslint10-config": "catalog:",
    "@types/estree": "catalog:",
    "@types/estree-jsx": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "npm-run-all2": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod-to-json-schema": "catalog:"
  }
}
