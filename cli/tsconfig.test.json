{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM"
    ],
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "vite.config.ts",
    "env.d.ts"
  ],
  "exclude": [
    "../node_modules",
    "dist"
  ]
}
